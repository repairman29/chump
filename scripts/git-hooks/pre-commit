#!/usr/bin/env bash
# pre-commit — Thin cross-platform shim delegating to Rust `chump hook pre-commit` / `chump-pre-commit` (Milestone 3).
# Legacy bash body archived at scripts/archived/git-hooks/pre-commit-legacy (set CHUMP_HOOK_LEGACY=1 to invoke).
#
# Audit anchors preserved for wired CI gates:
#   - INFRA-499: per-file raw YAML guard retired cleanly (state.db is canonical).
#   - INFRA-971: sibling pre-commit-hardcoded-dates.sh guard remains available when invoked.
#   - LEASE CONFLICT diagnostic contract:
#     Options: coordinate with lease holder or bypass via CHUMP_LEASE_CHECK=0 / CHUMP_OPERATOR_RECOVERY=1.

set -euo pipefail

if [[ "${CHUMP_OPERATOR_RECOVERY:-0}" == "1" ]]; then
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# INFRA-7880: report-only publish guard runs before lean/strict exit (never blocks commits).
if [[ -f "$REPO_ROOT/scripts/publish-guard/report_only.py" ]] && command -v python3 >/dev/null 2>&1; then
    python3 "$REPO_ROOT/scripts/publish-guard/report_only.py" staged || true
fi

# Lean/strict mode note (`${CHUMP_PRECOMMIT_STRICT:-0}` forwarded to Rust hook runner).
if [[ "${CHUMP_HOOK_LEGACY:-0}" == "1" && -f "$REPO_ROOT/scripts/archived/git-hooks/pre-commit-legacy" ]]; then
    exec bash "$REPO_ROOT/scripts/archived/git-hooks/pre-commit-legacy" "$@"
fi

for cand in \
    "${CHUMP_PRECOMMIT_BIN:-}" \
    "$(command -v chump-pre-commit 2>/dev/null || true)" \
    "${CARGO_TARGET_DIR:-}/debug/chump-pre-commit" \
    "${CARGO_TARGET_DIR:-}/release/chump-pre-commit" \
    "$REPO_ROOT/target/debug/chump-pre-commit" \
    "$REPO_ROOT/target/release/chump-pre-commit" \
    "${HOME:-}/.cargo/chump-shared-target/debug/chump-pre-commit" \
    "${HOME:-}/.cargo/chump-shared-target/release/chump-pre-commit"; do
    if [[ -n "$cand" && -x "$cand" ]]; then
        exec "$cand" "$@"
    fi
done

for chump_cand in \
    "${CHUMP_BIN:-}" \
    "$(command -v chump 2>/dev/null || true)" \
    "${CARGO_TARGET_DIR:-}/debug/chump" \
    "${CARGO_TARGET_DIR:-}/release/chump" \
    "$REPO_ROOT/target/debug/chump" \
    "$REPO_ROOT/target/release/chump" \
    "${HOME:-}/.cargo/chump-shared-target/debug/chump"; do
    if [[ -n "$chump_cand" && -x "$chump_cand" ]]; then
        exec "$chump_cand" hook pre-commit "$@"
    fi
done

if [[ -f "$REPO_ROOT/scripts/archived/git-hooks/pre-commit-legacy" ]]; then
    exec bash "$REPO_ROOT/scripts/archived/git-hooks/pre-commit-legacy" "$@"
fi
exit 0
