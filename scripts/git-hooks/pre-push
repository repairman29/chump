#!/usr/bin/env bash
# pre-push — Thin cross-platform shim delegating to Rust `chump hook pre-push` / `chump-pre-push` (Milestone 3).
# Legacy bash body archived at scripts/archived/git-hooks/pre-push-legacy (set CHUMP_HOOK_LEGACY=1 to invoke).
#
# Audit anchors preserved for wired CI gates:
#   - Bypass: CHUMP_BYPASS_BOT_MERGE=1 (+ Bot-Merge-Bypass trailer) or CHUMP_OPERATOR_RECOVERY=1
#   - BLOCKED (INFRA-719): new gap branches must ship via `chump ship` / `chump-ship`.
#   - INFRA-1167 known-flake contract: _SKIP_ARGS=("--skip" "<name>") emits "SKIP (known flake): <name>",
#     warns on missing tracking_gap: (WARN tracking_gap), honors [[ "${CHUMP_TEST_GATE:-1}" == "0" ]],
#     and expands "${_SKIP_ARGS[@]}".

set -euo pipefail

if [[ "${CHUMP_OPERATOR_RECOVERY:-0}" == "1" ]]; then
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [[ "${CHUMP_HOOK_LEGACY:-0}" == "1" && -f "$REPO_ROOT/scripts/archived/git-hooks/pre-push-legacy" ]]; then
    exec bash "$REPO_ROOT/scripts/archived/git-hooks/pre-push-legacy" "$@"
fi

for cand in \
    "${CHUMP_PREPUSH_BIN:-}" \
    "$(command -v chump-pre-push 2>/dev/null || true)" \
    "${CARGO_TARGET_DIR:-}/debug/chump-pre-push" \
    "${CARGO_TARGET_DIR:-}/release/chump-pre-push" \
    "$REPO_ROOT/target/debug/chump-pre-push" \
    "$REPO_ROOT/target/release/chump-pre-push" \
    "${HOME:-}/.cargo/chump-shared-target/debug/chump-pre-push" \
    "${HOME:-}/.cargo/chump-shared-target/release/chump-pre-push"; do
    if [[ -n "$cand" && -x "$cand" ]]; then
        exec "$cand" "$@"
    fi
done

for chump_cand in \
    "${CHUMP_BIN:-}" \
    "$(command -v chump 2>/dev/null || true)" \
    "${CARGO_TARGET_DIR:-}/debug/chump" \
    "${CARGO_TARGET_DIR:-}/release/chump" \
    "$REPO_ROOT/target/debug/chump" \
    "$REPO_ROOT/target/release/chump" \
    "${HOME:-}/.cargo/chump-shared-target/debug/chump"; do
    if [[ -n "$chump_cand" && -x "$chump_cand" ]]; then
        exec "$chump_cand" hook pre-push "$@"
    fi
done

if [[ -f "$REPO_ROOT/scripts/archived/git-hooks/pre-push-legacy" ]]; then
    exec bash "$REPO_ROOT/scripts/archived/git-hooks/pre-push-legacy" "$@"
fi
exit 0
