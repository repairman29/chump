<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chump.escalation</string>

  <!-- INFRA-1890: detector escalation tier. Runs hourly; scans
       ambient.jsonl for repeated unresolved failure signatures
       (gap_failed / pr_auto_rebase_failed / dirty_pr_unresolvable) and
       auto-files at most one follow-up gap per signature, deduped
       against the open gap registry (INFRA-1149 + META-063).

       Install: scripts/setup/chump-fleet-bootstrap.sh (or `cp` into
       ~/Library/LaunchAgents/ && launchctl load). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/jeffadkins/Projects/Chump &amp;&amp; bash scripts/coord/escalation-tier.sh || true</string>
  </array>

  <!-- Every 1 hour -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/chump-escalation-tier.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/chump-escalation-tier.err.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/jeffadkins/Projects/Chump</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jeffadkins</string>
    <key>PATH</key>
    <string>/Users/jeffadkins/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>CHUMP_SESSION_ID</key>
    <string>escalation-tier-cron</string>
  </dict>
</dict>
</plist>
