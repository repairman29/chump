<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chump.log-triage</string>

  <!-- INFRA-1891: daily structured pass over the last 24h of
       .chump-locks/ambient.jsonl cross-referenced against state.db.
       Writes .chump/triage/YYYY-MM-DD.md (+ today.md symlink) and emits
       kind=log_triage_completed / kind=log_triage_finding_high_signal.
       Operator gate: read .chump/triage/today.md each morning and decide
       which 0-5 candidates to file via `chump gap reserve`.

       Install: scripts/setup/chump-fleet-bootstrap.sh (or `cp` into
       ~/Library/LaunchAgents/ && launchctl load). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/jeffadkins/Projects/Chump &amp;&amp; ./target/release/chump fleet log-triage || true</string>
  </array>

  <!-- Daily at 09:00 local -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/chump-log-triage.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/chump-log-triage.err.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/jeffadkins/Projects/Chump</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jeffadkins</string>
    <key>PATH</key>
    <string>/Users/jeffadkins/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>CHUMP_SESSION_ID</key>
    <string>log-triage-cron</string>
  </dict>
</dict>
</plist>
