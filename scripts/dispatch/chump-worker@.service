[Unit]
Description=Chump headless fleet worker %i (RESILIENT-283 / INFRA-8639)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/chump
EnvironmentFile=-%h/.chump/node.env
ExecStart=/bin/bash %h/chump/scripts/dispatch/node-worker-run.sh %i
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
