# RESILIENT-1634 (PHASE-R) — the architect / Air-Traffic-Control standing loop
# as an ORGAN on cuphead instead of hand-work in a Mac desktop session. Fires
# ONE bounded `claude -p --model opus` architect tick (board + trunk + nodes +
# rollup; unstick by rebase/rerun only; file findings; never admin-merge, never
# push to main, never hand-implement) with zero desktop session open. Paired
# with chump-architect-tick.timer (every 30 min).
#
# SCOPE: user-scope (`systemctl --user`). Rendered through crates/chump-provision
# (__HOME__ / __REPO_ROOT__ placeholders, no host literal, no User=, no %h) so
# one unit text installs on any node's user manager.
#
# HYGIENE-CLASS: this organ is the fleet's traffic-cop. It is deliberately NOT
# gated by the fleet-paused sentinel (it reads + unsticks + files; it never
# claims a gap), so the fleet pause does NOT stop it — the architect keeps
# looping even while worker claims are paused. If declared in an organ manifest,
# tag it `role=janitor` (hygiene/housekeeping) so a role-scoped bring-up keeps
# it alive across node-converge.
#
# SHIPPED DISABLED. Enabling it is the operator's decision — see the PR body.
[Unit]
Description=Chump architect tick — one bounded claude -p --model opus ATC cycle (board/trunk/nodes/rollup, unstick-only) (RESILIENT-1634)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Source providers.env for ANTHROPIC/CLAUDE credentials (export format, so
# source it in a shell rather than systemd EnvironmentFile which can't parse
# `export KEY=val`). HOME is set so the user-scope manager resolves ~/.chump.
Environment=HOME=__HOME__
ExecStart=/bin/bash -lc 'set -a; source __HOME__/.chump/providers.env 2>/dev/null; set +a; exec __REPO_ROOT__/scripts/dispatch/architect-tick.sh'
