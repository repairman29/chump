# INFRA-3654 (PEER-VERI-07) — the standing consumer for
# kind=outcome_probe_failed (crates/chump-verify/src/external_verify_merge.rs)
# and kind=ac_coverage_proof_miss (crates/chump-verify/src/pr_ac_coverage.rs).
# Both emitters existed with no consumer: a PR's claimed live outcome could
# be mechanically proven false and nothing held the gap open or told anyone.
# This unit runs one pass of scripts/coord/outcome-verify-heal-consumer.sh,
# which tails ambient.jsonl for both kinds, holds/reopens the named gap, and
# pages the duty officer via notify-operator (RESILIENT-263's Discord DM
# path), deduped per (kind, gap) within a 1h window.
#
# CHUMP_REPO_ROOT is REQUIRED, same reasoning as chump-organ-watchdog.service:
# the script's default $HOME/Projects/Chump is capital-C and does not exist on
# case-sensitive Linux (docs/process/LINUX_NODE_ONBOARDING.md).
#
# Host-agnostic via the systemd /root specifier, same as chump-organ-watchdog.service
# (INFRA-3647): install-fleet-node.sh inserts the per-node User= line at
# deploy time, so /root resolves to root's home on helsinki and to jeff's home on
# an owned node (CJ) from this SAME tracked unit.
[Unit]
Description=Chump outcome-verify heal consumer — hold+page on failed live verification (INFRA-3654)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=CHUMP_REPO_ROOT=/root/Projects/chump
ExecStart=/bin/bash -lc 'set -a; source /root/.chump/providers.env 2>/dev/null; set +a; exec /root/Projects/chump/scripts/coord/outcome-verify-heal-consumer.sh'
