# chump-holler-drain.service — PRODUCT-320
# Drains user feedback events from Supabase into Chump gaps / Discord DM.
# Portable across nodes: uses %h/chump and EnvironmentFile=-%h/.chump/node.env
# (no host-specific /home/<user> literals).

[Unit]
Description=Holler feedback drain (Supabase -> Chump gap + Discord DM) (PRODUCT-320)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/chump
EnvironmentFile=-%h/.chump/node.env
EnvironmentFile=-%h/.chump/providers.env
EnvironmentFile=-%h/.chump/supabase.env
EnvironmentFile=-%h/.chump/holler.env
Environment=CHUMP_REPO_ROOT=%h/chump
Environment=CHUMP_BIN=%h/.local/bin/chump
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash %h/chump/scripts/ops/holler-drain.sh
TimeoutStartSec=90
StandardOutput=append:%h/.chump/logs/holler-drain.log
StandardError=append:%h/.chump/logs/holler-drain.log
