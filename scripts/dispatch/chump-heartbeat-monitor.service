# RESILIENT-290 — helsinki self-monitors its always-on critical set every 15 min
# and pages only when a CRITICAL heartbeat item is down. Paired with the .timer.
[Unit]
Description=Chump node heartbeat self-monitor (RESILIENT-290)
[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/bin/bash -lc 'set -a; source /root/.chump/providers.env 2>/dev/null; set +a; exec /root/Projects/chump/scripts/ops/node-heartbeat-check.sh --monitor'
