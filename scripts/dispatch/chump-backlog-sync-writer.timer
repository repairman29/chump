# CREDIBLE-292 — fires the backlog-sync writer every 15 min on the hub.
# Single-writer by design (RESILIENT-194 doc comment in backlog-sync.sh):
# only ONE node runs --writer so state.sql has one author and the git
# merge-driver rarely fires. Install ONLY on the hub (helsinki).
# Enable: systemctl enable --now chump-backlog-sync-writer.timer
# Watchdog coverage: chump-organ-watchdog.timer already self-heals ANY failed
# chump-* organ (reset-failed + restart) fleet-wide — no bespoke watchdog
# needed. Freshness is independently checked by
# scripts/coord/fleet-doctor-strict.sh's backlog-sync-freshness check
# (RED if origin/main .chump/state.sql goes >24h stale).
[Unit]
Description=Run the Chump backlog-sync writer every 15 minutes (CREDIBLE-292)

# ROOT-CAUSE FIX (2026-08-30): the trigger below was OnUnitActiveSec=15min, a
# self-chaining timer anchored to the service's last activation. On a
# daemon-reload or unit re-create the anchor timestamp is cleared, NextElapse
# resolves to infinity, and the timer sits 'active' but never fires again
# (this organ went dark Aug-2026; organ-watchdog only heals FAILED units, not
# idle-unscheduled ones). OnCalendar is wall-clock and self-anchoring, so the
# beat cannot silently die this way. Persistent=true still catches missed runs.
[Timer]
OnBootSec=3min
OnCalendar=*:0/15
Persistent=true

[Install]
WantedBy=timers.target
