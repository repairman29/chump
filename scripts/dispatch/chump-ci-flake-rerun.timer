# INFRA-375 / RESILIENT-306 — pairs with chump-ci-flake-rerun.service. Fires
# hourly (mirrors the retired launchd StartInterval=3600). Hourly is safe
# because every rerun is bounded: the per-run-id cooldown means a given failing
# run is only ever rerun once, and the per-PR flake budget stops a genuinely-
# failing PR from being thrashed. Enable: systemctl enable --now chump-ci-flake-rerun.timer
[Unit]
Description=Run the Chump CI flake auto-rerun hourly (INFRA-375)

[Timer]
OnBootSec=4min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
