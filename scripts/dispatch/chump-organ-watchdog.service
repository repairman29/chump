# INFRA-3595 — self-heal watchdog for the ATC organ roster. No human restarts
# a failed chump-* organ: this unit scans for failed chump-*.service units
# (typically stuck `failed (Result: start-limit-hit)` after a oneshot fails a
# few times in a row) and enabled-but-inactive chump-*.timer units, then
# systemctl reset-failed + restart/start them. Emits organ_self_healed per
# unit healed.
#
# CHUMP_REPO_ROOT is REQUIRED: the script's default $HOME/Projects/Chump is
# capital-C and does not exist on case-sensitive Linux (see
# docs/process/LINUX_NODE_ONBOARDING.md).
#
# INFRA-3647: host-agnostic via the systemd %h specifier (home dir of the
# configured User=) instead of a hardcoded root home path. install-helsinki
# -atc.sh (RESILIENT-353) inserts the per-node User= line at deploy time, so
# %h resolves to the root account's home on helsinki and to jeff's home on
# an owned node (CJ) from this SAME tracked unit — no per-host path-rewrite
# needed. Absent an explicit User=, systemd defaults a system unit to root,
# so %h still resolves to root's home (matching the prior hardcoded
# behavior).
[Unit]
Description=Chump organ watchdog — self-heal failed chump-* organs (INFRA-3595)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=%h
Environment=CHUMP_REPO_ROOT=%h/Projects/chump
Environment=CHUMP_ORGAN_WATCHDOG_CLONE_REFRESH=1
Environment=CHUMP_ORGAN_WATCHDOG_BINARY_HEAL=1
ExecStart=/bin/bash -lc 'set -a; source %h/.chump/providers.env 2>/dev/null; set +a; exec %h/Projects/chump/scripts/ops/organ-watchdog.sh'
