# RESILIENT-313 — the persistent farmer runner. The farmer (scripts/coord/farmer.sh,
# RESILIENT-068) is the un-killable control-plane tender that writes the heartbeat
# the worker binary gates on (RESILIENT-069). It is a single-TICK script; nothing
# on helsinki ever scheduled it. The fleet was kept alive only by a fragile,
# hand-installed *transient* `chump-farmer-bridge` unit — this repo-declared
# service+timer retires that hack. Paired with chump-farmer.timer (~every 30s,
# well under the 120s heartbeat-freshness threshold). Runs the wrapper
# (chump-farmer-run.sh) which sources providers.env, sweeps stale leases, and
# refreshes the oauth mtime before each tick.
# Path defaults target the primary node (helsinki, root).
[Unit]
Description=Chump farmer tick — keep the worker-gate heartbeat fresh so the fleet never darks out (RESILIENT-313)
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
# Source providers.env (export-format creds) in the unit's ExecStart — the same
# pattern chump-pr-lander.service uses — BEFORE handing off to the wrapper, so the
# organ's env is loaded even if the wrapper's own source path ever regresses. The
# wrapper then sets HOME/PATH, sweeps stale leases, refreshes oauth mtime, and
# execs one farmer tick (which writes ~/.chump/farmer-heartbeat unconditionally at
# tick start — the file the worker gate reads). Non-login shell (-c) so the
# host-rewriter's injected Environment=PATH (run-user's ~/.cargo/bin) is
# authoritative on every host, not reset by a login profile. Kept short so it
# always completes well inside the 30s timer cadence.
ExecStart=/bin/bash -c 'set -a; source /root/.chump/providers.env 2>/dev/null; set +a; exec /root/Projects/chump/scripts/dispatch/chump-farmer-run.sh'
TimeoutStartSec=120
