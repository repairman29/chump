# Dockerfile.ci-builder — INFRA-6435 (INFRA-2287 slice)
# INFRA-7507: Create Dockerfile for chump‑rust‑builder (INFRA-2287 slice) — satisfied by this file.
#
# Standalone builder image for chump-rust-builder: Rust 1.82 + sccache + mold
# + cranelift codegen backend + cargo-nextest + jq + gh + python3.
#
# Usage:
#   docker build -f docker/Dockerfile.ci-builder -t chump-rust-builder .

FROM rust:1.82-bookworm

# rustc's cranelift codegen backend ships as a rustup component on nightly;
# add nightly alongside the default 1.82 toolchain so `-Zcodegen-backend=cranelift`
# is available without disturbing the stable default.
RUN rustup toolchain install nightly \
    && rustup component add rustc-codegen-cranelift-preview --toolchain nightly

# Fetch cargo-binstall as a prebuilt binary (not `cargo install`) — newer
# cargo-binstall/sccache/cargo-nextest releases require a rustc newer than
# the pinned 1.82 toolchain to *compile from source*, but binstall's own
# prebuilt-binary downloads for sccache/cargo-nextest have no such constraint.
RUN curl -L --proto '=https' --tlsv1.2 -sSf \
        https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
        | bash \
    && cargo binstall -y sccache cargo-nextest

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl jq sqlite3 ca-certificates gnupg \
        build-essential pkg-config libssl-dev \
        mold python3 \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    RUSTC_WRAPPER=sccache \
    SCCACHE_DIR=/sccache

RUN rustc --version && cargo --version \
    && cargo nextest --version && sccache --version \
    && jq --version && git --version && gh --version && python3 --version \
    && mold --version \
    && rustup component list --toolchain nightly | grep -E 'cranelift.*\(installed\)'

LABEL org.opencontainers.image.source="https://github.com/repairman29/chump"
LABEL org.opencontainers.image.description="Chump Rust builder image (Rust 1.82 + sccache + mold + cranelift + cargo-nextest + jq + gh + python3)"
LABEL org.opencontainers.image.licenses="MIT"
