# ==============================================================================
# Chump v1.0 — Environment Overrides Reference (.env.example)
# ==============================================================================
# Primary configuration lives in ~/.chump/config.toml (%USERPROFILE%\.chump\config.toml
# on Windows). Scaffold and validate it first:
#
#   chump config init
#   chump config validate
#
# Copy this file to .env ONLY if you prefer environment-variable overrides for
# local development, containers, or CI runners. Never commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication & Primary Model Routing
# ------------------------------------------------------------------------------
# Subscription OAuth or API keys (referenced via api_key_env in config.toml):
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# FLEET_MODEL=sonnet

# OpenAI-compatible primary & fallback endpoints (Ollama, vLLM, LM Studio, llama.cpp):
OPENAI_API_BASE=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5-coder:14b
# CHUMP_FALLBACK_API_BASE=
# CHUMP_WORKER_API_BASE=
# CHUMP_WORKER_MODEL=

# Cascade & inference behavior:
# CHUMP_INFERENCE_BACKEND=openai_compatible
# CHUMP_INFERENCE_PERMITS=4
# CHUMP_LOCAL_ONLY=0
# CHUMP_AUTO_PRIVACY=1
# CHUMP_PROVIDER_TIMEOUT_S=120
# CHUMP_MODEL_REQUEST_TIMEOUT_SECS=300
# CHUMP_TEMPERATURE=0.2
# CHUMP_PROMPT_CACHE=1
# CHUMP_REASONING_MODE=auto
# CHUMP_REASONING_EFFORT=medium
# CHUMP_REASONING_BUDGET_TOKENS=8192
# INFERENCE_MESH_MAC_URL=
# INFERENCE_MESH_IPHONE_URL=

# ------------------------------------------------------------------------------
# 2. Optional In-Process mistral.rs Backend (--features mistralrs-infer)
# ------------------------------------------------------------------------------
# CHUMP_MISTRALRS_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
# CHUMP_MISTRALRS_HF_REVISION=main
# CHUMP_MISTRALRS_ISQ_BITS=4
# CHUMP_MISTRALRS_MOQE=0
# CHUMP_MISTRALRS_PAGED_ATTN=1
# CHUMP_MISTRALRS_PREFIX_CACHE_N=16
# CHUMP_MISTRALRS_STREAM_TEXT_DELTAS=1
# CHUMP_MISTRALRS_OUTPUT_JSON_SCHEMA=
# CHUMP_MISTRALRS_FORCE_CPU=0
# CHUMP_MISTRALRS_THROUGHPUT_LOGGING=0

# ------------------------------------------------------------------------------
# 3. Web Cockpit, Health & Push Notifications (chump --web)
# ------------------------------------------------------------------------------
CHUMP_WEB_HOST=127.0.0.1
CHUMP_WEB_PORT=3847
# CHUMP_WEB_TOKEN=
# CHUMP_HEALTH_PORT=3848
# CHUMP_VAPID_PUBLIC_KEY=
# CHUMP_VAPID_PRIVATE_KEY_FILE=
# CHUMP_VAPID_SUBJECT=mailto:ops@example.com
# CHUMP_WEB_PUSH_AUTONOMY=0

# ------------------------------------------------------------------------------
# 4. Multi-Agent Coordinator, Claims, Ship & Budgets
# ------------------------------------------------------------------------------
# CHUMP_HOME=~/.chump
# CHUMP_REPO=
# CHUMP_INIT_ANYWHERE=0
# CHUMP_INIT_ALLOWED_ROOTS=
# CHUMP_CLAIM_INTENT_WINDOW_S=30
# CHUMP_ENFORCE_INTENT_GATE=0
# CHUMP_SIBLING_WINDOW_H=24
# CHUMP_AC_GATE_ENABLED=1
# CHUMP_VERIFY_DISABLE=0
# CHUMP_PREFLIGHT_NO_SUGGEST=0
# CHUMP_BOT_MERGE_RETRY_MAX=3
# CHUMP_FLEET_MERGE_APPROVE=0
# CHUMP_FLEET_STATUS_GH_TIMEOUT_S=10
# CHUMP_OPERATOR_GITHUB_LOGIN=
# CHUMP_AUTO_PUSH=0
# CHUMP_AUTO_PUBLISH=0
# CHUMP_WIP_RETAIN=0
# CHUMP_PILLAR_BALANCE_WARN=1
# CHUMP_PILLAR_BALANCE_BLOCK=0
# CHUMP_PILLAR_BALANCE_MIN_POOL=10
# CHUMP_DAILY_BUDGET=25.0
# CHUMP_AUTONOMOUS_DAILY_COST_CAP_USD=25.0
# CHUMP_AUTONOMY_OWNER=
# CHUMP_AUTONOMY_ASSIGNEE=
# CHUMP_HEARTBEAT_DURATION=3600
# CHUMP_SPAWN_WORKERS_ENABLED=1
# CHUMP_SPAWN_MAX_PARALLEL=4

# ------------------------------------------------------------------------------
# 5. Agent Context, Memory, Skills & Observability
# ------------------------------------------------------------------------------
# CHUMP_CONTEXT_MAX_TOKENS=128000
# CHUMP_CONTEXT_SUMMARY_THRESHOLD=0.80
# CHUMP_MAX_CONTEXT_MESSAGES=80
# CHUMP_MAX_ITERATIONS=25
# CHUMP_AGENT_MAX_ITER=25
# CHUMP_MAX_CONCURRENT_TURNS=4
# CHUMP_RATE_LIMIT_TURNS_PER_MIN=60
# CHUMP_READ_FILE_MAX_CHARS=32000
# CHUMP_DB_PASSPHRASE=
# CHUMP_LESSONS_SEMANTIC=0
# CHUMP_LESSONS_EMBEDDING=0
# CHUMP_LESSONS_EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# CHUMP_LESSONS_EMBEDDING_MODEL=nomic-embed-text
# CHUMP_NEUROMOD_ENABLED=0
# CHUMP_SKILL_REGISTRIES=
# CHUMP_SKILL_SUGGEST_THRESHOLD=0.75
# CHUMP_MCP_SERVERS_DIR=
# ALMANAC_DB=
# TAVILY_API_KEY=
# CHUMP_VISION_ENABLED=0
# CHUMP_TTS_DISABLE=1
# CHUMP_TTS_PIPER_MODEL=
# RUST_LOG=info
# CHUMP_LOG_STRUCTURED=0
# CHUMP_LOG_TIMING=0
# CHUMP_TRACING_FILE=

# ------------------------------------------------------------------------------
# 6. Tool Governance, Approval Policies & Execution Backends
# ------------------------------------------------------------------------------
# CHUMP_TOOL_PROFILE=standard
# CHUMP_TOOL_ROUTING=0
# CHUMP_FORCE_JSON_TOOLS=0
# CHUMP_TOOLS_ASK=
# CHUMP_AUTO_APPROVE_LOW_RISK=1
# CHUMP_AUTO_APPROVE_TOOLS=
# CHUMP_PEER_APPROVE_TOOLS=
# CHUMP_POLICY_OVERRIDE_API=0
# CHUMP_POLICY_SKIP_APPROVAL=0
# CHUMP_APPROVAL_ESCALATION=0
# CHUMP_APPROVAL_ESCALATION_SECS=300
# CHUMP_APPROVAL_AUDIO=0
# CHUMP_APPROVAL_AUDIO_CMD=
# CHUMP_CLI_ALLOWLIST=
# CHUMP_CLI_BLOCKLIST=
# CHUMP_CLI_TIMEOUT_SECS=120
# CHUMP_TOOL_ENV_ALLOWLIST=
# CHUMP_TOOL_TIMEOUT_SEC=60
# CHUMP_TOOL_TIMEOUT_SECS=60
# CHUMP_TOOL_MAX_IN_FLIGHT=8
# CHUMP_MAX_CONSECUTIVE_TOOL_FAILS=3
# CHUMP_TOOL_RATE_LIMIT_TOOLS=
# CHUMP_TOOL_RATE_LIMIT_MAX=30
# CHUMP_TOOL_RATE_LIMIT_WINDOW_SECS=60
# CHUMP_EXECUTIVE_MODE=0
# CHUMP_EXECUTIVE_TIMEOUT_SECS=300
# CHUMP_EXECUTIVE_MAX_OUTPUT_CHARS=64000
# CHUMP_SANDBOX_ENABLED=0
# CHUMP_SANDBOX_TIMEOUT_SECS=180
# CHUMP_SANDBOX_DISK_BUDGET_MB=2048
# CHUMP_SSH_HOST=
# CHUMP_SSH_USER=
# CHUMP_SSH_PORT=22
# CHUMP_SSH_OPTIONS=
# CHUMP_ADB_TIMEOUT=30
# CHUMP_ADB_MAX_OUTPUT=16384

# ------------------------------------------------------------------------------
# 7. Optional Messaging & Webhook Integrations (Dormant When Unset)
# ------------------------------------------------------------------------------
# Slack Socket Mode (chump --slack):
# SLACK_APP_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_API_BASE=https://slack.com/api

# Telegram Bot HTTP Adapter (CHUMP_TELEGRAM_ENABLED=1):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_POLL_TIMEOUT_SECS=30

# Generic Webhooks:
# CHUMP_WEBHOOK_URL=
# CHUMP_WEBHOOK_TOKEN=
# CHUMP_WEBHOOK_SLACK=0

# Discord Bot Adapter (chump --discord):
# DISCORD_TOKEN=
# CHUMP_DISCORD_TURN_TIMEOUT_S=300
