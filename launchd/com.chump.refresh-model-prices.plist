<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  com.chump.refresh-model-prices — INFRA-1564 LaunchAgent.

  Runs scripts/dev/refresh-model-prices.sh in refresh + check-registry mode, weekly.
  Diffs docs/pricing/model_rates.yaml and docs/dispatch/model_registry.yaml
  against LiteLLM upstream. Emits kind=model_prices_refreshed to
  .chump-locks/ambient.jsonl (plus kind=pricing_drift ALERT on actual drift).

  INSTALLATION:
    1. cp launchd/com.chump.refresh-model-prices.plist ~/Library/LaunchAgents/
    2. sed -i '' "s|/path/to/Chump|$(pwd)|g" ~/Library/LaunchAgents/com.chump.refresh-model-prices.plist
    3. launchctl load ~/Library/LaunchAgents/com.chump.refresh-model-prices.plist
    4. Verify: launchctl list | grep com.chump.refresh-model-prices
       Logs: tail /tmp/chump-refresh-model-prices.out.log

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.chump.refresh-model-prices.plist
    rm ~/Library/LaunchAgents/com.chump.refresh-model-prices.plist
-->
<dict>
  <key>Label</key>
  <string>com.chump.refresh-model-prices</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/path/to/Chump/scripts/dev/refresh-model-prices.sh</string>
    <string>--refresh</string>
    <string>--check-registry</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/Chump</string>

  <!-- Weekly: every 604800 seconds. -->
  <key>StartInterval</key>
  <integer>604800</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/chump-refresh-model-prices.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/chump-refresh-model-prices.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/opt/homebrew/sbin</string>
  </dict>

  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
