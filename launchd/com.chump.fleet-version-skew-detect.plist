<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  com.chump.fleet-version-skew-detect — INFRA-1564 LaunchAgent.

  Runs scripts/dev/fleet-version-skew-detect.sh in quiet mode every 6 hours.
  Detects when the working-tree scripts/dispatch/worker.sh diverges from
  origin/main. Emits kind=version_skew_detected to .chump-locks/ambient.jsonl
  every run (plus the existing kind=fleet_version_skew ALERT on detection).

  INSTALLATION:
    1. cp launchd/com.chump.fleet-version-skew-detect.plist ~/Library/LaunchAgents/
    2. sed -i '' "s|/path/to/Chump|$(pwd)|g" ~/Library/LaunchAgents/com.chump.fleet-version-skew-detect.plist
    3. launchctl load ~/Library/LaunchAgents/com.chump.fleet-version-skew-detect.plist
    4. Verify: launchctl list | grep com.chump.fleet-version-skew-detect
       Logs: tail /tmp/chump-fleet-version-skew-detect.out.log

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.chump.fleet-version-skew-detect.plist
    rm ~/Library/LaunchAgents/com.chump.fleet-version-skew-detect.plist
-->
<dict>
  <key>Label</key>
  <string>com.chump.fleet-version-skew-detect</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/path/to/Chump/scripts/dev/fleet-version-skew-detect.sh</string>
    <string>--quiet</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/Chump</string>

  <!-- Every 6 hours: 21600 seconds. -->
  <key>StartInterval</key>
  <integer>21600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/chump-fleet-version-skew-detect.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/chump-fleet-version-skew-detect.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/opt/homebrew/sbin</string>
  </dict>

  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
